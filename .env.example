# Copie ce fichier en ".env" et adapte les valeurs à ton installation MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=utrax

# Clé secrète pour signer les sessions des écoles — remplace-la par une longue
# chaîne aléatoire avant toute mise en production.
JWT_SECRET=change-moi-en-production

# Clé que TOI seul connais, pour les actions réservées à UTRAX
# (créer un établissement, le désactiver, générer un virement...).
ADMIN_KEY=change-moi-aussi

PORT=4000
